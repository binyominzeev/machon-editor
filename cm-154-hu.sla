                <ITEXT FONT="Liberation Serif Italic" CH="he­zek re­i­já"/>
                <ITEXT CH="t – vö. 16. pont vé­ge, "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Grá"/>
                <ITEXT CH=": nem mond­hat­ja a má­sik, hogy már "/>
                <ITEXT FONT="Liberation Serif Italic" CH="chá­zá­ká­ja"/>
                <ITEXT CH=" van "/>
