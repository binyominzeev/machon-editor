                <ITEXT CH=", mond­ván, hogy mi lesz, ha majd oda­épít"/>
                <para PARENT="lista"/>
                <ITEXT CH="Na­gyon so­kan ezt pasz­ken­ol­ják, ez a hal­ac­ha ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Me­cháb­ér"/>
