                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Hogy pon­to­san mi szá­mít fény­re szánt ab­lak­nak, ar­ról sok ri­so­nim vé­le­mény van – a dá­ján­nak kell meg­ítél­nie min­den hely­ze­tet"/>
                <para PARENT="lista"/>
                <para/>
