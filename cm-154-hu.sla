                <DefaultStyle ALIGN="1" DIRECTION="1" FONT="Arial Bold" FONTSIZE="15"/>
                <ITEXT CH="חזקת חלונות ופתחים וכמה צריך להתרחק מהן"/>
                <para/>
                <ITEXT FONTSIZE="13" CH="ובו לב סעיפים"/>
                <para/>
            </StoryText>
