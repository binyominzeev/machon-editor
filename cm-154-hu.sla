        </MASTEROBJECT>
        <PAGEOBJECT XPOS="140.00062992126" YPOS="150.394960629922" OwnPage="0" ItemID="1598634842" PTYPE="4" WIDTH="255.118110236221" HEIGHT="621.606299212598" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L255.118 0 L255.118 621.606 L0 621.606 L0 0 Z" copath="M0 0 L255.118 0 L255.118 621.606 L0 621.606 L0 0 Z" gXpos="140.00062992126" gYpos="982.397480314961" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1605158922" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0" FONT="Liberation Serif Regular"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="א"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Liberation Serif Bold" CH="Aj­tó nyi­tá­sa, ud­va­rok össze­nyi­tá­sa"/>
                <para PARENT="Default Paragraph Style" ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="(Ab­lak nyi­tá­sa: ld. 3. pont)"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Aki­nek két szom­szé­dos ud­var­ban van két szom­szé­dos há­za, nem nyit­hat­ja őket össze („já­rás so­ka­sí­tá­sa” mi­att)"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Új la­kás­ré­szé­nek aj­ta­ját se az ud­var­ból, ha­nem a sa­ját há­zá­ból nyis­sa"/>
                <para PARENT="lista" LINESP="16"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Liberation Serif Bold" CH="Új la­kás­részt"/>
                <ITEXT CH=" azon­ban ad­hat hoz­zá, és fel is oszt­hat­ja a sa­ját­ját (hi­á­ba nö­ve­li a la­kó­kat, és így a for­gal­mat is)"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Ha szom­szé­dos a két la­ká­sa, vagy új la­kás­ré­sze van, eze­ket össze­nyit­hat­ja?"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Mách­lok­et"/>
                <ITEXT CH=", de a könnyí­tő vé­le­mény sze­rint is csak ak­kor, ha a má­sik ud­var­be­li be­já­ra­tot le­zár­ja, hogy ne hoz­zon lét­re át­já­ró­há­zat"/>
                <para PARENT="lista2"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="ב"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Liberation Serif Bold" CH="Új la­kók ho­zá­sa"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Akár a töb­bi la­kó, akár a bér­be­adó til­ta­koz­hat el­le­ne (hoz­zá­já­ru­lást nem kö­te­les kér­ni?)"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Ha azon­ban el­lát­ja őket, nem til­ta­koz­hat­nak"/>
                <para PARENT="lista" LINESP="16"/>
                <para LINESP="16"/>
                <para LINESP="16"/>
                <para LINESP="16"/>
                <para LINESP="16"/>
                <para LINESP="16"/>
                <para LINESP="16"/>
                <para LINESP="16"/>
                <para LINESP="16"/>
                <ITEXT CH="Más vé­le­mény sze­rint akár­hány ven­dé­get hoz­hat, csak ne bő­vít­se ki a há­zát"/>
                <para PARENT="lista"/>
                <ITEXT CH="(ez utób­bi "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Rás­bám"/>
                <ITEXT CH=" vé­le­mé­nye, azon­ban a "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Me­cháb­ér"/>
                <ITEXT CH=" az 1. pont­ban ez­zel szem­ben pasz­ken­olt)"/>
                <para PARENT="lista2"/>
                <para/>
                <ITEXT CH="Még az sem til­ta­ko­zá­si alap esze­rint, hogy csök­ken­tik a "/>
                <ITEXT FONT="Liberation Serif Bold" CH="kö­zös mos­dó"/>
                <ITEXT CH=" hasz­ná­la­ti le­he­tő­sé­gét"/>
                <para PARENT="lista"/>
                <ITEXT FONT="Liberation Serif Bold" CH="Iker­ház"/>
                <ITEXT CH=" ese­tén azon­ban ugyan­ez mű­kö­dő érv"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="ג"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Liberation Serif Bold" CH="Ab­la­kok nyi­tá­sa, szem­köz­ti nyí­lá­sok"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="En­ge­délyt kell kér­nie még a kö­zös ud­var­hoz is"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Ha nem já­rul­nak hoz­zá, be kell fa­laz­nia"/>
                <para PARENT="lista2"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Ha hoz­zá­já­rul­tak, ak­kor sem le­het­nek "/>
                <ITEXT FONT="Liberation Serif Bold" CH="egy­más­sal szem­ben"/>
                <ITEXT CH=" (vö. Bi­le­ám "/>
                <ITEXT FONT="Liberation Serif Italic" CH="„má tovu”"/>
                <ITEXT CH=" ál­dá­sa)"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Ha eh­hez is hoz­zá­já­rul­tak, utó­lag bár­mi­kor visz-sza­von­hat­ják (nincs "/>
                <ITEXT FONT="Liberation Serif Italic" CH="chá­zá­ká"/>
                <ITEXT CH=" – si­ma ab­lak­ra vi­szont van, ld. 7. pont)"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Mách­lok­et"/>
                <ITEXT CH=", hogy az ab­lak ese­té­ben van-e "/>
                <ITEXT FONT="Liberation Serif Italic" CH="chá­zá­ká"/>
                <ITEXT CH=" (aj­tó­ban biz­to­san nin­csen)"/>
                <para PARENT="lista2"/>
                <ITEXT CH="Ha egy­szer­re nyi­tot­ták – aki nem ve­szít, az vál­toz­tas­son (ha kü­lön-kü­lön: ld. 14. pont)"/>
                <para PARENT="lista"/>
                <ITEXT FONT="Liberation Serif Bold" CH="Kö­zös ud­var­ban"/>
                <ITEXT CH=" mi­ni­má­lis el­to­lás elég"/>
                <para PARENT="lista2"/>
                <ITEXT FONT="Liberation Serif Bold" CH="Szom­szé­dos ud­var­ban"/>
                <ITEXT CH=" lá­tó­tá­vol­ság­nyi"/>
                <para PARENT="lista2"/>
                <ITEXT FONT="Liberation Serif Bold" CH="Köz­te­rü­le­ten"/>
                <ITEXT CH=" (4 ámá alatt) nem kell"/>
                <para PARENT="lista2"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Az eme­let épí­té­se el­le­ni til­ta­ko­zás ld. ké­sőbb: 14-17. pont"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <ITEXT FONT="Liberation Serif Italic" CH="Má­voj"/>
                <ITEXT CH=" (több ud­var elő­te­re) ak­kor lesz köz­te­rü­let, ha van 3 la­kás ott vagy ha "/>
                <ITEXT FONT="Liberation Serif Italic" CH="me­fu­lás"/>
                <ITEXT CH=" – "/>
                <ITEXT FONT="Liberation Serif Italic" CH="mách­lok­et"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <ITEXT CH="Ami­kor még a köz­te­rü­let sem elég ki­fo­gás:"/>
                <para PARENT="lista"/>
                <ITEXT CH="Ha "/>
                <ITEXT FONT="Liberation Serif Bold" CH="ud­var"/>
                <ITEXT CH=" nyí­lik az ab­lak­kal szem­ben"/>
                <para PARENT="lista2"/>
                <ITEXT CH="Ha "/>
                <ITEXT FONT="Liberation Serif Bold" CH="bol­tot"/>
                <ITEXT CH=" nyit, ahol ál­lan­dó­an ül"/>
                <para PARENT="lista2"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Van, aki sze­rint egy­ál­ta­lán "/>
                <ITEXT FONT="Liberation Serif Bold" CH="ne né­ze­lőd­jön "/>
                <ITEXT CH="más ab­la­kán, a gya­nak­vást el­ke­rü­len­dő"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="ד"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Liberation Serif Bold" CH="Kis nyí­lás bő­ví­té­se"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="En­ge­dély kell az aj­ta­ja ki­szé­le­sí­té­sé­hez"/>
                <para PARENT="lista" LINESP="16"/>
