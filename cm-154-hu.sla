                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Ha ő ma­ga zár­ta be, az csak ak­kor le­mon­dás, ha ál­lan­dó jel­leg­gel tör­tént"/>
                <para PARENT="lista"/>
                <ITEXT CH="Ha vi­ta van, hogy ki zár­ta be, az ab­la­kos a "/>
                <ITEXT FONT="Liberation Serif Italic" CH="much­zák"/>
                <para PARENT="lista"/>
                <ITEXT CH="(Pe­dig va­ló­já­ban mind­ket­tő akar újat: az ab­la­kos a zárt ab­la­kát ki­nyit­ni, az ud­va­ros rá­épí­te­ni – ld. "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Kcot"/>
