                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Ha vi­szont az ab­la­kos akar moz­gat­ni, az en­ge­dély­kö­te­les (ki­vé­ve hely­ben ki­seb­bí­tés, ahogy az aj­tó­nál is)"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="A kö­zös ud­var sa­ját fa­lát le­rom­bol­hat­ja, aki egye­dül fi­zet­te ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Ne­t­i­vot"/>
                <ITEXT CH=": csak ha nincs ben­ne "/>
