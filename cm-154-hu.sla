                <ITEXT FONT="Liberation Serif Bold" CH="Rom­ra"/>
                <ITEXT CH=" nyi­tott ab­lak ugyan­ez: nem ér­vel­he­ti a rom tu­laj­do­no­sa, hogy za­var­ja a "/>
                <ITEXT FONT="Liberation Serif Italic" CH="he­zek re­i­já"/>
                <para PARENT="lista"/>
                <ITEXT CH="Ezért a rom­ra nyi­tott ab­lak­nak csak ta­núk­kal le­het chá­zá­ká­ja"/>
                <para PARENT="lista"/>
                <ITEXT CH="Ezért he­lyes rom­bo­lás­kor ta­nú­kat ál­lí­ta­ni (kü­lön­ben be­sö­té­tít­he­tik)"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT FONT="Liberation Serif Bold" CH="Te­tő"/>
                <ITEXT CH=" is olyan mint a rom: amíg hasz­nál­ha­tat­lan, rá­nyit­hat"/>
                <para PARENT="lista"/>
                <ITEXT CH="De amint hasz­nál­ni kez­di, be­zár­at­tat­hat­ja az ab­la­kot"/>
                <para PARENT="lista"/>
                <para PARENT="Text58_Caption"/>
                <ITEXT FONT="Liberation Serif Bold" CH="Te­tő-rom kü­lönb­ség"/>
