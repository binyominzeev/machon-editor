                <ITEXT CH=" "/>
                <ITEXT FONT="Liberation Serif Bold" CH="For­dí­tott ab­lak-chá­zá­ká"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Az ab­lak tu­laj­do­no­sa is el­ve­szít­he­ti a chá­zá­ká­ját"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Ha be­sö­té­tí­tik, és ő nem til­ta­ko­zik"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Azon­nal kell til­ta­koz­nia – ha ezt nem tet­te meg, ne­ki kell bi­zo­nyí­ta­nia, hogy nem tu­dott ró­la, más­hol volt"/>
                <ITEXT FONT="Liberation Serif Italic" CH=" (Kcot, JD 155:43 alap­ján)"/>
                <para PARENT="lista2"/>
                <para/>
                <para/>
                <para/>
                <para/>
