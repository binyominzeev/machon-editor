                <ITEXT FONTSIZE="10" CH="Eme­le­ti ab­lak­nál re­le­váns, mert föld­szin­ten amúgy sincs "/>
                <ITEXT FONT="Liberation Serif Italic" FONTSIZE="10" CH="he­zek re­i­já"/>
                <ITEXT FONTSIZE="10" CH=" (ld. 3. pont). Ugyan­ott sze­re­pel ha egy­szer­re akar­nak nyit­ni – ez a pont a ri­son­ról szól "/>
                <para PARENT="lista" LINESP="14"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Rá­bé­nu Jo­ná "/>
                <ITEXT CH="sze­rint csak fél-ab­la­kot nyit­hat, he­lyet hagy­va a má­sik épí­ten­dő ab­la­ká­nak, "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Ros"/>
                <ITEXT CH=" és "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Rás­bá"/>
                <ITEXT CH=" sze­rint nem"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Ha nem te­re­get­nek az ut­cán, ak­kor ezt is pasz­ken­ol­juk (ld. köv. pont)"/>
                <para PARENT="lista2"/>
                <ITEXT CH="Mert ez olyan, mint­ha a "/>
                <ITEXT FONT="Liberation Serif Italic" CH="hef­ker­"/>
                <ITEXT CH="ből (köz­te­rü­le­ti lá­tás­ból) sze­rez­ne"/>
                <para PARENT="lista" LINESP="16"/>
                <para/>
                <para/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="טו"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" Olyan he­lyen, ahol az ut­cán is te­re­get­nek"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Ek­kor nem köz­te­rü­let­nek, ha­nem kö­zös ud­var­nak szá­mít"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Ha az egyik nyi­tott bár­mit ar­ra, at­tól még a má­sik is ugyan­úgy nyit­hat"/>
                <para PARENT="lista" LINESP="16"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="טז"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" "/>
