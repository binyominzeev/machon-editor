                <ITEXT FONT="Liberation Serif Bold" CH=" az elő­ször nyi­tott eme­le­ti ab­lak­ra"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT FONTSIZE="10" CH="(Ha ab­la­kot nyit a má­sik­ra, az en­ge­dély­kö­te­les, ld. 3. pont. Itt vi­szont nem fo­gad­juk el a til­ta­ko­zá­sát – cse­ré­be vi­szont „sö­té­tí­tős” chá­zá­kát sem nyer az ab­la­kos – "/>
                <ITEXT FONT="Liberation Serif Italic" FONTSIZE="10" CH="ld. Áh&quot;S :21"/>
                <ITEXT FONTSIZE="10" CH=")"/>
                <para PARENT="lista" LINESP="14"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Ros"/>
                <ITEXT CH=": az ab­la­kot most ki­nyit­hat­ja, de ha hasz­nál­ni kez­di a te­rü­le­tét a má­sik, ak­kor be kell fa­laz­nia"/>
                <para PARENT="lista" LINESP="16"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Sőt, az ab­la­kos "/>
                <ITEXT FONT="Liberation Serif Bold" CH="fény­re sem kap chá­zá­kát"/>
                <ITEXT CH=", elé is épít­het (azért, mert a má­sik­nak nem volt le­he­tő­sé­ge til­ta­koz­ni, így "/>
                <ITEXT FONT="Liberation Serif Italic" CH="chá­zá­ká"/>
                <ITEXT CH=" sincs – vö. 10. pont.)"/>
                <para PARENT="lista"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Ros"/>
                <ITEXT CH=" ál­tal pasz­ken­olt konk­rét eset, ahol eze­ket a sza­bá­lyo­kat al­kal­maz­za"/>
