                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="De "/>
                <ITEXT FONT="Liberation Serif Bold Italic" CH="chá­zá­ká­ja"/>
                <ITEXT CH=" et­től még nem lesz, ha a má­sik meg­en­ge­di ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Rám­bán"/>
                <ITEXT CH="), hi­á­ba lett vol­na le­he­tő­sé­ge til­ta­koz­ni is"/>
                <para PARENT="lista"/>
                <ITEXT CH="Vi­szont ha el­ső­nek épít eme­le­tet az ut­ca­fron­ton (ld. 14. pont), ak­kor nem ala­kul ki chá­zá­ká, a szem­be­lé­vő bár­mi­kor be­sö­té­tít­he­ti (pl. egy sok­kal na­gyobb eme­let­tel)"/>
                <para PARENT="lista"/>
                <para/>
                <ITEXT CH="Ha olyan "/>
                <ITEXT FONT="Liberation Serif Bold" CH="fal dől össze ma­gá­tól"/>
                <ITEXT CH=", ami­re nincs rá­ha­tá­sunk, és ed­dig he­zek re­i­já­tól vé­dett, ak­kor az ab­la­kot kell be­töm­ni (ld. még 13. pont vé­ge)"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Ha egy kö­zép­ső, "/>
                <ITEXT FONT="Liberation Serif Bold" CH="el­vá­lasz­tó ház dőlt össze"/>
                <ITEXT CH=", ahon­nan szin­tén be le­he­tett lát­ni"/>
                <para PARENT="lista"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Re­mo"/>
                <ITEXT CH=" sze­rint ek­kor nem kell be­töm­ni ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Pit­ché Cho­s­en"/>
                <ITEXT CH=" is ef­fe­lé haj­lik), de "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Kcot-Ne­t­i­vot"/>
                <ITEXT CH=" sze­rint csak ak­kor, ha övé a ház, és fel­épít­het­né"/>
                <para PARENT="lista2"/>
                <para/>
                <para/>
                <ITEXT CH="Van, aki vi­tat­ja, hogy be kell-e töm­ni, hi­szen jo­go­san épí­tet­te ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Pit­ché Te­su­vá / Rab­bi Aki­va Ei­ger"/>
                <ITEXT CH=" ezt vi­tat­ja, de a "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Re­mo"/>
                <ITEXT CH=" ké­sőbb is fel­hasz­nál­ja, ld. 19. pont)"/>
                <para PARENT="lista"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="יז"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" Osz­toz­ko­dás előt­ti jog­szer­zés"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Ha "/>
                <ITEXT FONT="Liberation Serif Italic" CH="sut­fin­"/>
                <ITEXT CH="ra nyit ab­la­kot, az egyik el­né­zi, a má­sik nincs ott"/>
                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Még "/>
                <ITEXT FONT="Liberation Serif Italic" CH="te­náj"/>
                <ITEXT CH=" sem elég ah­hoz, hogy meg­tart­sa a chá­zá­ká­ját, osz­toz­ko­dás után­ra ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Szmá: dá­vár se­lo bá lá­o­lám"/>
                <ITEXT CH=")"/>
                <para PARENT="lista" LINESP="16"/>
                <para/>
                <para LINESP="22"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="יח"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" Nem zsi­dó­tól vá­sár­lás / be­sö­té­tí­tés"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Liberation Serif Bold Italic" CH="(ko­ách ákum)"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Ha az ab­la­ka a nem zsi­dó te­rü­le­té­re nyí­lott, az új zsi­dó ve­vő nem sö­té­tít­he­ti be épít­ke­zés­sel"/>
                <para PARENT="lista" LINESP="16"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Re­mo"/>
                <ITEXT CH=" sze­rint azon­ban igen­is "/>
                <ITEXT FONT="Liberation Serif Bold" CH="meg­örö­köl­he­ti"/>
                <ITEXT CH=" a nem zsi­dó jo­ga­it"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="A nem zsi­dó a fi­ze­tés­sel el­ve­szí­ti a jo­got – a föld "/>
                <ITEXT FONT="Liberation Serif Bold Italic" CH="hef­ker"/>
                <ITEXT CH=" lesz, és a szom­széd jo­got sze­rez az ab­la­ká­ra"/>
                <para PARENT="lista"/>
                <ITEXT CH="Ezért kell előbb bir­tok­ba ven­ni, és csak az­után fi­zet­ni"/>
                <para PARENT="lista2"/>
                <ITEXT CH="Ha két­ség van, hogy az ab­lak volt előbb, vagy a nem zsi­dó bir­tok, ak­kor a ve­vő­nek kell bi­zo­nyí­ta­nia ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="hef­ker"/>
                <ITEXT CH=" té­mák "/>
                <ITEXT FONT="Liberation Serif Italic" CH="ld. CM 194"/>
                <ITEXT CH=")"/>
                <para PARENT="lista2"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="יט"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" Nem zsi­dó­tól örö­köl­he­tő-e "/>
                <ITEXT FONT="Liberation Serif Bold Italic" CH="chá­zá­ká"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Me­cháb­ér"/>
                <ITEXT CH=" sze­rint nem, "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Re­mo"/>
                <ITEXT CH=" sze­rint igen"/>
                <para PARENT="lista"/>
                <ITEXT CH="Ugyan­úgy vi­táz­nak mint az elő­ző pont­ban"/>
                <para PARENT="lista2"/>
                <ITEXT CH="Annyi a kü­lönb­ség, hogy me­lyi­kő­jük nyi­tot­ta"/>
                <para PARENT="lista2"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Re­mo"/>
                <ITEXT CH=" sze­rint nem le­het be­zá­rat­ni, amit nem ti­la­lom­ban nyi­tott ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Ne­t­i­vot"/>
                <ITEXT CH=", ld. 16. pont leg­vé­ge, ott "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Rab­bi Aki­va Ei­ger"/>
                <ITEXT CH=" vi­tat­ko­zik)"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Ha a nem zsi­dó nyi­tott ab­la­kot, ak­kor az új ve­vő "/>
                <ITEXT FONT="Liberation Serif Italic" CH="Re­mo"/>
                <ITEXT CH=" sze­rint az el­adó jo­gát örök­li meg"/>
                <para PARENT="lista"/>
                <ITEXT CH="Az ok­irat­tal kap­cso­la­tos ese­tek is ezt a fő­sza­bályt kö­ve­tik"/>
                <para PARENT="lista2"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="כ"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" Vak­ab­lak"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="A nem zsi­dó szom­széd elől kí­vül­ről be­zár­ta az ab­la­kát, de ami­kor zsi­dó köl­tö­zött oda, ki­nyit­ná"/>
                <para PARENT="lista"/>
                <ITEXT CH="Az új szom­széd vi­szont rá­épí­te­ne"/>
                <para PARENT="lista2"/>
                <ITEXT CH="A be­fa­la­zás "/>
                <ITEXT FONT="Liberation Serif Italic" CH="gi­luj dá­át"/>
                <ITEXT CH=", hogy le­mon­dott a fé­nyé­ről ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Bách:"/>
                <ITEXT CH=" mert be­lül­ről is fa­laz­hat­ta vol­na, ha csak a szom­széd "/>
                <ITEXT FONT="Liberation Serif Italic" CH="he­zek re­i­já­"/>
                <ITEXT CH="ja za­var­ná)"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="To­váb­bá: le­het hogy még az elő­ző nem zsi­dó la­kó fa­laz­ta be az ab­la­kot (és ak­kor nin­csen "/>
                <ITEXT FONT="Liberation Serif Italic" CH="chá­zá­ká"/>
                <ITEXT CH=")"/>
                <para PARENT="lista"/>
                <ITEXT CH="Ez ha­son­lít a 12. pont vé­gén a vi­tá­hoz, de ott ép­pen a má­sik­nak adunk iga­zat"/>
                <para PARENT="lista2"/>
                <ITEXT FONT="Liberation Serif Italic" CH="Kcot"/>
                <ITEXT CH=": ott ki­ala­kul "/>
                <ITEXT FONT="Liberation Serif Italic" CH="chez­kát má­rá ká­má"/>
                <ITEXT CH=", itt a nem zsi­dó­val szem­ben nem tud ki­ala­kul­ni"/>
                <para PARENT="lista2"/>
                <para/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="כא"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" Sa­ját ma­gá­nak oko­zott "/>
                <ITEXT FONT="Liberation Serif Bold Italic" CH="he­zek re­i­já"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="Aki ab­lak alá épí­tett új ud­vart, nem zá­rat­hat­ja be az ab­la­kot, hi­szen ő vál­lal­ta ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="hech­zik bá­he­zek"/>
                <ITEXT CH=")"/>
                <para PARENT="lista"/>
                <ITEXT CH="4 ámá tá­vol­ság­ban épít­het fa­lat: magát védheti, de a másikat nem sötétítheti be"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT FONT="Liberation Serif Bold" CH="Ala­csony ab­lak­kal szem­ben"/>
                <ITEXT CH=" az ab­la­kos meg­kö­ve­tel­he­ti, hogy a má­sik leg­alább 4 ámá ma­gas fa­lat épít­sen"/>
                <para PARENT="lista"/>
                <para LINESP="18"/>
                <ITEXT FONT="Liberation Serif Bold" CH="Ma­gas ab­lak­kal szem­ben"/>
                <ITEXT CH=" akár kö­ze­li és ala­csony fa­lat is épít­het"/>
                <para PARENT="lista"/>
                <ITEXT CH="Ki­vé­ve, ha a fal te­te­jé­ről áll­va be tud néz­ni"/>
                <para PARENT="lista2"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para LINESP="24"/>
                <ITEXT CH="De közterületen nincsen ilyen korlátozás ("/>
                <ITEXT FONT="Liberation Serif Italic" CH="Remo"/>
                <ITEXT CH=")"/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para LINESP="25"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="כב"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" V"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="A "/>
                <para PARENT="lista"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para LINESP="25"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="כב"/>
                <ITEXT FONT="Liberation Serif Bold" CH=" V"/>
                <para ALIGN="0" DIRECTION="0" LINESP="16" ParagraphEffectCharStyle="" ParagraphEffectOffset="5.66929133858268" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0"/>
                <ITEXT CH="A "/>
                <para PARENT="lista"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="416.88251968504" YPOS="150.394960629922" OwnPage="0" ItemID="1598816138" PTYPE="4" WIDTH="255.118110236221" HEIGHT="621.606299212598" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L255.118 0 L255.118 621.606 L0 621.606 L0 0 Z" copath="M0 0 L255.118 0 L255.118 621.606 L0 621.606 L0 0 Z" gXpos="416.88251968504" gYpos="982.397480314961" gWidth="0" gHeight="0" ALIGN="3" LAYER="0" NEXTITEM="1605113130" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" DIRECTION="1" LINESP="18" FONT="David CLM Medium" FONTSIZE="14"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="א"/>
                <ITEXT FONTSIZE="14" CH=" אחד מהשותפין בחצר"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="שלקח בית בחצר אחרת"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="אינו יכול לפתוח פתחו"/>
                <ITEXT FONTSIZE="14" CH=" לחצר השותפים שלו"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="12" CH="(שכל אחד מבני החצר אין לו רשות לשנות כלל"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="12" CH="אלא כמו שבנאו או קנאו או "/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="12" CH="ירשוהו"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="12" CH="יש להם לנהוג בו) "/>
                <ITEXT FONTSIZE="10" CH="(טור סע&quot;ב)"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="אפילו"/>
                <ITEXT FONTSIZE="14" CH=" בנה עלייה על גב ביתו"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="לא יעשה לה "/>
                <ITEXT FONTSIZE="12" CH="(פתח)"/>
                <ITEXT FONTSIZE="14" CH=" לתוך החצר"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="לפי שמרבה עליהם את הדרך"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="נעשה כמי שהיה לו שכן אחד"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="ונעשו לו שכנים הרבה"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="אבל"/>
                <ITEXT FONTSIZE="14" CH=" יכול הוא "/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="לבנות עלייה"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="על גב ביתו בנין חדש"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="ובלבד"/>
                <ITEXT FONTSIZE="14" CH=" שלא תהא פתוחה לחצר"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="אלא לתוך ביתו"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="ואצ&quot;ל "/>
                <ITEXT FONTSIZE="14" CH="שאם רצה"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH=" לחלוק "/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="12" CH="(ביתו)"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH=" לשנים"/>
                <ITEXT FONTSIZE="14" CH=" חולק"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="כיון"/>
                <ITEXT FONTSIZE="14" CH=" שאינו פותח פתח אחר לחצר"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="בד&quot;א"/>
                <ITEXT FONTSIZE="14" CH=" שאם לקח בית בחצר אחרת"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="אינו יכול לפתוח פתחו לחצר השותפים"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="בפותחו "/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="לחצר ממש"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="אבל"/>
                <ITEXT FONTSIZE="14" CH=" יכול לפתחו לתוך ביתו"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="והוא "/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="שיסתום הפתח "/>
                <ITEXT FONTSIZE="14" CH="שהיה לו בחצר אחרת"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="12" CH="("/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="12" CH="ויש חולקין"/>
                <ITEXT FONTSIZE="12" CH=" דאפילו לתוך ביתו אסור לפתחו)"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="10" CH="(טור בשם הרא&quot;ש)"/>
                <ITEXT FONTSIZE="14" CH=": "/>
                <para LINESP="18"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="ב "/>
                <ITEXT FONTSIZE="14" CH="אחד מהשותפין בחצר"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="שהביא לביתו אנשי "/>
                <ITEXT FONTSIZE="14" CH="בית אחרת"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="יש לחבירו לעכב עליו"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="מפני"/>
                <ITEXT FONTSIZE="14" CH=" שמרבה עליו את הדרך"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="וכן"/>
                <ITEXT FONTSIZE="14" CH=" "/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="המשכיר"/>
                <ITEXT FONTSIZE="14" CH=" ביתו לבעל הבית אחד"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="ואח&quot;כ "/>
                <ITEXT FONTSIZE="14" CH="הביא עמו קרוביו או מיודעיו"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="לשכון עמו כאחד בבית זה"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="הרי"/>
                <ITEXT FONTSIZE="14" CH=" המשכיר מעכב"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="ואם"/>
                <ITEXT FONTSIZE="14" CH=" הם "/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="14" CH="סמוכים על שלחנו"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="אינו יכול לעכב עליו"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="14" CH="לא השותף ולא המשכיר:"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="12" CH="הגה "/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="12" CH="וי&quot;א"/>
                <ITEXT FONTSIZE="12" CH=" דשותף יכול למלאות ביתו אכסנאים ודיורים"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="12" CH="כל שאינו מוסיף בנין חדש"/>
                <para LINESP="18"/>
                <ITEXT FONTSIZE="10" CH="(טור בשם רשב&quot;ם ונ&quot;י בשם הרי&quot;ף והרמב&quot;ן וריטב&quot;א)"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="12" CH="אע&quot;פ "/>
                <ITEXT FONTSIZE="12" CH="שחולק ביתו לדיורים"/>
                <para LINESP="18"/>
                <ITEXT FONT="David CLM Bold" FONTSIZE="12" CH="ויש להן בית הכסא"/>
                <ITEXT FONTSIZE="12" CH=" אחד ביחד"/>
                <para LINESP="18"/>
