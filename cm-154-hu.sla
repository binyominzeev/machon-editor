                <para PARENT="lista" LINESP="16"/>
                <ITEXT CH="Ez elég ah­hoz, hogy a má­sik­nak ne le­gyen jo­ga oda­épí­tés ál­tal sö­té­tí­te­ni (vö. 16. pont, ha fel­té­te­le­sen ka­pott csak en­ge­délyt)"/>
